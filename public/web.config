<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="ContactSmtpHost" value="" />
    <add key="ContactSmtpPort" value="587" />
    <add key="ContactSmtpUser" value="" />
    <add key="ContactSmtpPass" value="" />
    <add key="ContactSmtpEnableSsl" value="true" />
    <add key="ContactFromAddress" value="" />
    <add key="ContactToAddress" value="" />
  </appSettings>
  <system.web>
    <customErrors mode="Off"/>
    <compilation debug="true" targetFramework="4.0"/>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <!-- Allow api-contact.php to be served directly -->
        <rule name="API Contact" stopProcessing="true">
          <match url="^api-contact\.php$" />
          <action type="Rewrite" url="/api-contact.php" />
        </rule>
        <!-- Allow api-contact.ashx to be served directly -->
        <rule name="API Contact ASHX" stopProcessing="true">
          <match url="^api-contact\.ashx$" />
          <action type="Rewrite" url="/api-contact.ashx" />
        </rule>
        <!-- Allow api-claim.php to be served directly -->
        <rule name="API Claim" stopProcessing="true">
          <match url="^api-claim\.php$" />
          <action type="Rewrite" url="/api-claim.php" />
        </rule>
        <!-- Serve /tirosh as a standalone page -->
        <rule name="Tirosh Page" stopProcessing="true">
          <match url="^tirosh/?$" />
          <action type="Rewrite" url="/tirosh/index.html" />
        </rule>
        <!-- Serve /claim as a standalone page -->
        <rule name="Claim Page" stopProcessing="true">
          <match url="^claim/?$" />
          <action type="Rewrite" url="/claim/index.html" />
        </rule>
        <!-- Serve /Foreigners via SPA -->
        <rule name="Foreigners Page" stopProcessing="true">
          <match url="^[Ff]oreigners/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <!-- Allow api-foreigners.php -->
        <rule name="API Foreigners" stopProcessing="true">
          <match url="^api-foreigners\.php$" />
          <action type="Rewrite" url="/api-foreigners.php" />
        </rule>
        <!-- Allow bbq directory to be served directly for social media bots -->
        <rule name="BBQ Directory" stopProcessing="true">
          <match url="^bbq/?$" />
          <action type="Rewrite" url="/bbq/index.html" />
        </rule>
        <!-- Handle React Router - all routes should go to index.html -->
        <!-- This includes /buyinsnew and /bbq even if a directory exists with that name -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api)" negate="true" />
            <!-- Allow access to API handlers -->
            <add input="{REQUEST_URI}" pattern="^/api-shatap\.(ashx|php)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api-bbq\.(ashx|php)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api-contact\.php" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api-claim\.php" negate="true" />
            <!-- Allow access to static files in buyinsnew directory (images) -->
            <add input="{REQUEST_URI}" pattern="^/buyinsnew/.*\.(png|jpg|jpeg|gif|svg|webp|ico)$" negate="true" />
            <!-- Allow access to static assets -->
            <add input="{REQUEST_URI}" pattern="^/assets/.*" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/.*\.(js|css|json|ico|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
    <!-- Enable compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <!-- Static file caching and MIME types -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
  </system.webServer>
</configuration>
