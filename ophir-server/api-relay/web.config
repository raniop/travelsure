<?xml version="1.0" encoding="UTF-8"?>
<!-- Only for /api-relay: claims carry scanned documents (base64), above ASP.NET's 4 MB default. -->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="30720" executionTimeout="300" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
